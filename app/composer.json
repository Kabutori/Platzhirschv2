{
  "name": "platzhirsch/application",
  "type": "project",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "platzhirsch/identity": "0.1.3",
    "platzhirsch/provisioning": "0.1.3",
    "platzhirsch/contracts": "0.1.0",
    "platzhirsch/billing": "0.1.3",
    "platzhirsch/reporting": "0.1.3",
    "platzhirsch/support": "0.1.3",
    "platzhirsch/reservation": "0.1.3",
    "platzhirsch/widget": "0.1.3",
    "platzhirsch/customer": "0.1.3",
    "platzhirsch/module-host": "0.1.3",
    "platzhirsch/weather": "0.1.3",
    "platzhirsch/audit": "0.1.3",
    "platzhirsch/notification": "0.1.3",
    "platzhirsch/release": "0.1.3",
    "platzhirsch/integration-odoo": "0.1.3",
    "platzhirsch/api": "0.1.3",
    "platzhirsch/mcp": "0.1.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "mockery/mockery": "^1.6",
    "fakerphp/faker": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "packages/*",
      "options": {
        "symlink": false
      }
    }
  ]
}
