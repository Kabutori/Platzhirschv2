{
  "name": "platzhirsch/application",
  "type": "project",
  "require": {"php": "^8.3", "laravel/framework": "^13.0", "ext-pdo": "*", "ext-mbstring": "*", "ext-openssl": "*"},
  "require-dev": {"phpunit/phpunit": "^12.0", "mockery/mockery": "^1.6", "fakerphp/faker": "^1.24"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": "phpunit"},
  "config": {"sort-packages": true, "optimize-autoloader": true, "allow-plugins": {}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
