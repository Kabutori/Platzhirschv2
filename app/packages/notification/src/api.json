    {
      "id": "notification.post.restaurant_notifications_id_retry",
      "method": "POST",
      "uri": "api/v1/restaurant/notifications/{id}/retry",
      "action": "App\\Modules\\Notification\\Http\\NotificationController@retry",
      "context": "restaurant",
      "exposure": "external",
      "scope": "notification:write",
      "confirmation": true,
      "mcp": true,
      "contract": {
        "parameters": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Kennung im Pfad."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "query": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "body": {
          "type": "object",
          "properties": {
            "password": {
              "type": "string",
              "x-validation": [
                "required",
                "string"
              ],
              "writeOnly": true
            },
            "confirmed": {
              "enum": [
                true,
                1,
                "1",
                "yes",
                "on",
                "true"
              ],
              "x-validation": [
                "required",
                "accepted"
              ]
            },
            "expected_attempt_id": {
              "type": [
                "integer",
                "null"
              ],
              "x-validation": [
                "present",
                "nullable",
                "integer",
                "min:1"
              ],
              "minimum": 1
            },
            "expected_status": {
              "type": "string",
              "x-validation": [
                "required",
                "string"
              ]
            },
            "acknowledge_duplicate": {
              "enum": [
                true,
                1,
                "1",
                "yes",
                "on",
                "true"
              ],
              "x-validation": [
                "required",
                "accepted"
              ]
            }
          },
          "required": [
            "password",
            "confirmed",
            "expected_attempt_id",
            "expected_status",
            "acknowledge_duplicate"
          ],
          "additionalProperties": true
        },
        "example": {
          "parameters": {
            "id": "Beispiel"
          },
          "query": {},
          "body": {
            "password": "Beispiel",
            "confirmed": true,
            "expected_attempt_id": 1,
            "expected_status": "Beispiel",
            "acknowledge_duplicate": true
          }
        },
        "responses": {
          "200": {
            "description": "Fachantwort; zusätzliche additive Felder sind möglich.",
