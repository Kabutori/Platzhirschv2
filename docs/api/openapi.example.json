{
  "openapi": "3.1.0",
  "info": {
    "title": "Platzhirsch externe API – Zielvertrag",
    "version": "1.0.0",
    "description": "Entwurf; diese externen Routen sind noch nicht implementiert."
  },
  "servers": [
    {
      "url": "https://platzhirsch.example/api/external/v1"
    }
  ],
  "security": [
    {
      "bearerToken": []
    }
  ],
  "paths": {
    "/reservation/reservations": {
      "get": {
        "operationId": "reservation.list",
        "x-required-scopes": ["reservation:read"],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationPage"
                }
              }
            }
          },
          "default": {
            "description": "Fach- oder Zugriffsfehler",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "reservation.create",
        "x-required-scopes": ["reservation:write"],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "default": {
            "description": "Fach- oder Zugriffsfehler",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque scoped token"
      }
    },
    "schemas": {
      "ReservationListQuery": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": ["date"],
        "additionalProperties": false
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "version": {
            "type": "integer"
          },
          "guest_name": {
            "type": "string"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "version", "guest_name", "starts_at", "ends_at"]
      },
      "ReservationPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reservation"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "next_cursor": {
                "type": ["string", "null"]
              },
              "request_id": {
                "type": "string"
              }
            },
            "required": ["next_cursor", "request_id"]
          }
        },
        "required": ["data", "meta"]
      },
      "ReservationCreate": {
        "type": "object",
        "properties": {
          "guest_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "party_size": {
            "type": "integer",
            "minimum": 1
          },
          "table_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["guest_name", "party_size", "table_ids", "starts_at", "ends_at"],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "code", "request_id"]
      }
    }
  }
}
